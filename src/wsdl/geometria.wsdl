<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrato WSDL 1.1 del servicio GeometriaService -->
<definitions name="GeometriaService"
  targetNamespace="http://practica.soap/geometria"
  xmlns="http://schemas.xmlsoap.org/wsdl/"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:tns="http://practica.soap/geometria"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- 1. Tipos y elementos de petición y respuesta -->
  <types>
    <xsd:schema targetNamespace="http://practica.soap/geometria" elementFormDefault="qualified">
      <!-- Tipo reutilizable para las dos operaciones: dimensiones de un rectángulo -->
      <xsd:complexType name="Rectangulo">
        <xsd:sequence>
          <xsd:element name="base" type="xsd:double"/>
          <xsd:element name="altura" type="xsd:double"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="AreaRectanguloRequest" type="tns:Rectangulo"/>
      <xsd:element name="AreaRectanguloResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="area" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="PerimetroRectanguloRequest" type="tns:Rectangulo"/>
      <xsd:element name="PerimetroRectanguloResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="perimetro" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <!-- 2. Mensajes de entrada y salida de cada operación -->
  <message name="AreaRectanguloInput">
    <part name="parameters" element="tns:AreaRectanguloRequest"/>
  </message>
  <message name="AreaRectanguloOutput">
    <part name="parameters" element="tns:AreaRectanguloResponse"/>
  </message>
  <message name="PerimetroRectanguloInput">
    <part name="parameters" element="tns:PerimetroRectanguloRequest"/>
  </message>
  <message name="PerimetroRectanguloOutput">
    <part name="parameters" element="tns:PerimetroRectanguloResponse"/>
  </message>

  <!-- 3. Operaciones ofrecidas y su correspondencia con los mensajes -->
  <portType name="GeometriaPortType">
    <operation name="AreaRectangulo">
      <input message="tns:AreaRectanguloInput"/>
      <output message="tns:AreaRectanguloOutput"/>
    </operation>
    <operation name="PerimetroRectangulo">
      <input message="tns:PerimetroRectanguloInput"/>
      <output message="tns:PerimetroRectanguloOutput"/>
    </operation>
  </portType>

  <!-- 4. Vinculación con SOAP 1.1 sobre HTTP (estilo document/literal) -->
  <binding name="GeometriaBinding" type="tns:GeometriaPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="AreaRectangulo">
      <soap:operation soapAction="http://practica.soap/geometria/AreaRectangulo"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="PerimetroRectangulo">
      <soap:operation soapAction="http://practica.soap/geometria/PerimetroRectangulo"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <!-- 5. Servicio y dirección HTTP del endpoint -->
  <service name="GeometriaService">
    <documentation>Cálculo de área y perímetro de un rectángulo a partir de su base y altura.</documentation>
    <port name="GeometriaPort" binding="tns:GeometriaBinding">
      <soap:address location="http://localhost:3000/soap/geometria"/>
    </port>
  </service>
</definitions>
